index 000000000..0d1e904c0
--- /dev/null
+++ b/tests/unit/test_docs_read_the_result_envelope.py
@@ -0,0 +1,103 @@
+"""Documented snippets must read a tool result as {status, data, metadata}.
+
+Filed as #869. A tool call returns the envelope, so a snippet that measures
+the result with len() measures the envelope's three keys, and one that guards
+with isinstance(result, list) never enters its own branch. Both failures are
+silent: nothing raises, and the printed line looks like a result.
+
+Measured on main at the time of writing, with the envelope in force:
+
+    r = tu.run({"name": "PubMed_search_articles", ...})
+    len(r)                 # 3   -- status, data, metadata
+    isinstance(r, list)    # False
+    r["status"]            # "success", even for a query matching nothing
+
+docs/guide/api_keys.rst told a reader to verify their API keys with
+`"success" if len(result) > 0 else "failed"`, which prints success whether or
+not the key works. docs/guide/literature_search_tools_tutorial.rst guarded
+four printing blocks with isinstance(result, list), so none of them could run,
+and its safe_search helper returned "Unexpected result format" for every call
+that succeeded.
+
+This test does not ban a spelling. It reads each code block, finds the names
+bound from tu.run(...), and fails if such a name is then used as a sequence in
+the same block.
+"""
+
+import re
+from pathlib import Path
+
+import pytest
+
+_GUIDE = Path(__file__).resolve().parents[2] / "docs" / "guide"
+
+
+def _code_blocks(text):
+    """Each `.. code-block:: python` body, as a list of lines."""
+    lines = text.splitlines()
+    out, i = [], 0
+    while i < len(lines):
+        if re.match(r"^\s*\.\. code-block:: python\s*$", lines[i]):
+            indent = len(lines[i]) - len(lines[i].lstrip())
+            body, j = [], i + 1
+            while j < len(lines):
+                line = lines[j]
+                if line.strip() and (len(line) - len(line.lstrip())) <= indent:
+                    break
+                body.append(line)
+                j += 1
+            out.append(body)
+            i = j
+        else:
+            i += 1
+    return out
+
+
+def _offences(body):
+    """Names bound from tu.run(...) that are then used as a sequence."""
+    names = set()
+    for line in body:
+        m = re.match(r"\s*(\w+)\s*=\s*tu\.run\(", line)
+        if m:
+            names.add(m.group(1))
+    bad = []
+    for name in sorted(names):
+        for line in body:
+            if re.match(rf"\s*{name}\s*=\s*tu\.run\(", line):
+                continue
+            if re.search(rf"\blen\(\s*{name}\s*\)", line) or re.search(
+                rf"\bisinstance\(\s*{name}\s*,\s*list\s*\)", line
+            ):
+                bad.append(line.strip())
+    return bad
+
+
+def _rst_files():
+    return sorted(_GUIDE.rglob("*.rst"))
+
+
+def test_the_guide_has_code_blocks_to_check():
+    assert any(_code_blocks(f.read_text(encoding="utf-8")) for f in _rst_files())
+
+
+@pytest.mark.parametrize("path", _rst_files(), ids=lambda p: p.name)
+def test_no_snippet_measures_the_envelope(path):
+    found = []
+    for body in _code_blocks(path.read_text(encoding="utf-8")):
+        found.extend(_offences(body))
+    assert not found, (
+        f"{path.name}: a tu.run() result is used as a sequence, which measures "
+        f"the envelope rather than the data: {found}"
+    )
+
+
+def test_the_api_key_check_can_actually_fail():
+    text = (_GUIDE / "api_keys.rst").read_text(encoding="utf-8")
+    checks = re.findall(r'print\("(?:PubMed|OpenTargets) test:".*', text)
+    assert len(checks) == 2, f"expected the two connectivity checks, found {checks}"
+    for line in checks:
+        assert "len(result)" not in line, (
+            "len() on the envelope is 3 whatever happened, so this prints "
+            f"success unconditionally: {line}"
+        )
+        assert 'result.get("status")' in line, line
diff --git a/tests/unit/test_smcp_says_what_it_is_for.py b/tests/unit/test_smcp_says_what_it_is_for.py
new file mode 100644
index 000000000..59ced2966
--- /dev/null
+++ b/tests/unit/test_smcp_says_what_it_is_for.py
@@ -0,0 +1,87 @@
+"""The MCP host must be told what this server is for.
+
+Filed as #875. FastMCP's `instructions` is the one piece of text an MCP host
+puts verbatim into the model's context when a session opens. SMCP passed only
+`name`, so that text was empty:
+
+    super().__init__(name=name or "SMCP Server", **fastmcp_kwargs)
+
+and `grep -rn "instructions=" src/tooluniverse/` returned nothing, so no entry
+point supplied one either. With deferred tools -- Claude Code lists MCP tools
+by name only -- the model saw `find_tools`, `grep_tools`, `execute_tool` and
+nothing saying those names lead to genes, drugs, trials or variants.
+
+The text is derived rather than written down, so it stays true as the
+catalogue grows and as a deployment's own category filters narrow it.
+"""
+
+import pytest
+
+from tooluniverse.smcp import SMCP
+
+
+@pytest.fixture(scope="module")
+def server():
+    return SMCP(name="probe", tool_categories=["uniprot"], compact_mode=True)
+
+
+def test_the_host_is_told_something(server):
+    assert server.instructions, "FastMCP instructions is what the host shows the model"
+    assert len(server.instructions) > 80
+
+
+def test_it_names_the_entry_points_that_exist(server):
+    registered = set(server._exposed_tools)
+    if getattr(server, "_find_tools_registered", False):
+        registered.add("find_tools")
+    named = {
+        name
+        for name in (
+            "find_tools",
+            "list_tools",
+            "grep_tools",
+            "get_tool_info",
+            "execute_tool",
+        )
+        if name in server.instructions
+    }
+    assert named, "the instructions name no entry point at all"
+    assert named <= registered, (
+        f"the instructions advertise entry points this server does not register: "
+        f"{sorted(named - registered)}"
+    )
+
+
+def test_it_names_a_subject_area_a_caller_would_search_for(server):
+    assert "uniprot" in server.instructions.lower()
+
+
+def test_it_does_not_offer_this_server_s_plumbing_as_a_subject(server):
+    lowered = server.instructions.lower()
+    for plumbing in ("compact_mode", "tool_finder"):
+        assert plumbing not in lowered, (
+            f"{plumbing} is this server's own machinery, not a database to search"
+        )
+
+
+def test_a_caller_supplied_value_is_left_alone():
+    chosen = "This deployment serves one lab and nothing else."
+    server = SMCP(
+        name="probe",
+        tooluniverse_config={},
+        auto_expose_tools=False,
+        search_enabled=False,
+        instructions=chosen,
+    )
+    assert server.instructions == chosen
+
+
+def test_a_server_with_nothing_loaded_still_says_what_it_is():
+    server = SMCP(
+        name="probe",
+        tooluniverse_config={},
+        auto_expose_tools=False,
+        search_enabled=False,
+    )
+    assert server.instructions
+    assert "tooluniverse" in server.instructions.lower()
